{
  "expo": {
    "owner": "lostab",
    "name": "WAFL",
    "slug": "wafl-mobile",
    "version": "2.0.0",
    "scheme": "wafl",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      [
        "expo-image-picker",
        {
          "photosPermission": "WAFL 작업지시서에 사용할 사진을 선택하기 위해 사진 보관함 접근이 필요합니다.",
          "cameraPermission": "WAFL 작업지시서 이미지를 촬영하기 위해 카메라 접근이 필요합니다.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wafl.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wafl.app",
      "adaptiveIcon": {
        "backgroundColor": "#f3eee4"
      }
    },
    "extra": {
      "appVersion": "2.0.0-alpha.67",
      "mockOnly": false,
      "dataMode": "dev-test-tailscale-auto-connect",
      "router": {},
      "eas": {
        "projectId": "6cc3b260-a2cc-4c97-9c15-764bda530836"
      }
    }
  }
}
